<?xml version="1.0" encoding="utf-8"?>
<com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/connection_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/touchscene_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- ============================================================== -->
        <!-- 顶部 Header: 品牌标识与适配硬件标签 -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tech_radar"
                app:tint="@color/touchscene_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="@string/touchscene_home_title"
                    android:textColor="@color/touchscene_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/touchscene_home_subtitle"
                    android:textColor="@color/touchscene_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tech_status_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Ace Pro 2"
                android:textColor="@color/touchscene_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- 核心 Hero 控制卡片: 垂直居中于屏幕偏中黄金触达区 -->
        <!-- ============================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_connect_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/touchscene_card_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toTopOf="@+id/device_info_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_layout"
            app:layout_constraintVertical_bias="0.44"
            app:strokeColor="@color/touchscene_card_stroke"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 状态指示药丸 (Status Badge) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_tech_status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/status_indicator_dot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tech_radar"
                        app:tint="@color/touchscene_primary" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/touchscene_status_ready"
                        android:textColor="@color/touchscene_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="系统就绪 · 等待连接" />
                </LinearLayout>

                <!-- 居中超大 Wi-Fi 连接按钮 (76dp 高度，极佳手感与无障碍触控) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/touchscene_primary"
                    android:contentDescription="@string/touchscene_wifi_hero_accessibility"
                    android:elevation="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/touchscene_wifi_hero_title"
                    android:textColor="#060C17"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_tech_wifi"
                    app:iconGravity="textStart"
                    app:iconPadding="14dp"
                    app:iconSize="30dp"
                    app:iconTint="#060C17"
                    app:rippleColor="#80FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_local_image"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/touchscene_card_bg"
                    android:contentDescription="@string/touchscene_local_image_accessibility"
                    android:elevation="3dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/touchscene_local_image_title"
                    android:textColor="@color/touchscene_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconGravity="textStart"
                    app:iconPadding="14dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/touchscene_primary"
                    app:rippleColor="#8000E5FF"
                    app:strokeColor="@color/touchscene_primary"
                    app:strokeWidth="1.5dp" />

                <!-- 连接过程/结果终端读数 -->
                <TextView
                    android:id="@+id/connection_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:text="@string/touchscene_wifi_hero_desc"
                    android:textColor="@color/touchscene_text_secondary"
                    android:textSize="13sp"
                    tools:text="点击上方按钮，通过 Wi-Fi 快速连接影石相机" />

                <!-- 断开连接按钮 (已连接时出现) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnect_btn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:enabled="false"
                    android:text="@string/disconnect"
                    android:textColor="@color/demo_error_red"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/demo_error_red"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================== -->
        <!-- 兼容保留区: 蓝牙扫描、USB、无相机演示等隐藏组件 (保持逻辑与测试不破损) -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/hidden_compat_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_usb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scan_recycler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entry_touchscene_local_demo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- 相机控制台 HUD 卡片: 已连接状态展示 (电量、存储、型号、序列号) -->
        <!-- ============================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/device_info_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/touchscene_card_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toTopOf="@+id/entry_capture_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hero_connect_card"
            app:strokeColor="@color/touchscene_card_stroke"
            app:strokeWidth="1.5dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- HUD 标题 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tech_camera"
                        app:tint="@color/touchscene_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/touchscene_camera_hud_title"
                        android:textColor="@color/touchscene_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refresh_dynamic_btn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/refresh_dynamic_info"
                        android:textColor="@color/touchscene_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 遥测数据 HUD 栅格 (2x2 模块) -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="2">

                    <!-- 模块 1: 相机型号 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_tech_hud_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camera_model"
                            android:textColor="@color/touchscene_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/camera_model"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/touchscene_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Ace Pro 2" />
                    </LinearLayout>

                    <!-- 模块 2: 电池电量 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_tech_hud_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_level"
                            android:textColor="@color/touchscene_text_muted"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/battery_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/touchscene_success"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="92%" />

                            <TextView
                                android:id="@+id/charging_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textColor="@color/touchscene_text_muted"
                                android:textSize="11sp"
                                tools:text="未充电" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 模块 3: SD 卡剩余存储 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_tech_hud_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sd_remaining_capacity"
                            android:textColor="@color/touchscene_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/sd_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/touchscene_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="48.5 GB" />
                    </LinearLayout>

                    <!-- 模块 4: 相机序列号 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tech_hud_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camera_sn"
                            android:textColor="@color/touchscene_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/camera_sn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textColor="@color/touchscene_text_primary"
                            android:textSize="13sp"
                            tools:text="INSP2K..." />
                    </LinearLayout>
                </GridLayout>

                <!-- 隐藏的冗余数据视图 (保留 ID 以供 ViewModel 绑定赋值) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">

                    <TextView android:id="@+id/firmware_version" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/activate_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/sd_total" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/sd_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/internal_total" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/internal_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/internal_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/camera_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================== -->
        <!-- 业务入口: 核心体验“进入触觉感知探索”主 CTA -->
        <!-- ============================================================== -->
        <LinearLayout
            android:id="@+id/entry_capture_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/device_info_card"
            tools:visibility="visible">

            <!-- 醒目全宽 CTA 主按键: 进入触觉预览与摸索画布 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/entry_preview"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:backgroundTint="@color/touchscene_accent_orange"
                android:elevation="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/touchscene_enter_preview_hero"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="24dp"
                app:iconTint="@color/white" />

            <!-- 次要入口（默认保留但设为隐藏/备用） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/entry_no_preview"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/capture_page_no_preview"
                    android:textColor="@color/touchscene_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/entry_live_stream"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/live_stream_entry"
                    android:textColor="@color/touchscene_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView>
