<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/back_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/back_to_connection"
                    android:textColor="@color/demo_accent"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:id="@+id/preview_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/demo_divider">

                    <TextView
                        android:id="@+id/preview_placeholder_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:minHeight="200dp"
                        android:text="@string/realtime_preview_window"
                        android:textColor="@color/demo_secondary_text" />

                    <FrameLayout
                        android:id="@+id/preview_capture_mask"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/demo_divider"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@string/capture_preview_unsupported_while_capturing"
                            android:textColor="@color/demo_secondary_text" />
                    </FrameLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/raw_frame_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/raw_frame_waiting"
                android:textColor="@color/demo_secondary_text"
                android:textSize="13sp" />

            <TextView
                style="@style/DemoSectionTitle"
                android:layout_marginTop="16dp"
                android:text="@string/touchscene_title" />

            <TextView
                android:id="@+id/touchscene_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/touchscene_waiting_map"
                android:textColor="@color/demo_primary_text" />

            <Button
                android:id="@+id/debug_layer_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/touchscene_debug_touch_map" />

            <com.insta360.kmpsdk.demo.touchscene.TactileMapView
                android:id="@+id/tactile_map_view"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:contentDescription="@string/touchscene_map_content_description"
                android:focusable="true"
                android:importantForAccessibility="yes" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/map_move_up_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/touchscene_move_up" />

                <Button
                    android:id="@+id/map_move_down_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/touchscene_move_down" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/map_move_left_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/touchscene_move_left" />

                <Button
                    android:id="@+id/map_move_right_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/touchscene_move_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/freeze_map_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchscene_freeze" />

                <Button
                    android:id="@+id/refresh_map_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/touchscene_refresh" />

            </LinearLayout>

            <Button
                android:id="@+id/return_live_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/touchscene_return_live" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/describe_scene_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchscene_describe" />

                <Button
                    android:id="@+id/voice_command_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/touchscene_voice_command" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/haptic_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/touchscene_haptic_enabled" />

            <Button
                android:id="@+id/haptic_self_test_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/touchscene_haptic_self_test" />

            <LinearLayout
                android:id="@+id/lens_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/DemoSectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/lens_selection" />

                <HorizontalScrollView
                    android:id="@+id/lens_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/lens_chip_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                style="@style/DemoSectionTitle"
                android:layout_marginTop="20dp"
                android:text="@string/capture_mode" />

            <HorizontalScrollView
                android:id="@+id/mode_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/mode_chip_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/open_mode_params_sheet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/mode_params_setting"
                    android:textColor="@color/demo_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/open_preview_params_sheet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="end"
                    android:padding="8dp"
                    android:text="@string/preview_params_setting"
                    android:textColor="@color/demo_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sd_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/demo_secondary_text"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="SD：可用 · 剩余 12.3GB"
                tools:visibility="visible" />

            <Button
                android:id="@+id/capture_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/demo_accent"
                android:text="@string/start_capture"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/capture_sub_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/demo_secondary_text"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="曝光中…"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/capture_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/demo_primary_text"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="00:12"
                tools:visibility="visible" />
            <LinearLayout
                android:id="@+id/result_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/demo_chip_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/capture_result"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/demo_primary_text"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    tools:text="OK" />
            </LinearLayout>
        </LinearLayout>
    </com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView>

    <com.insta360.kmpsdk.demo.widget.LoadingView
        android:id="@+id/blocking_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
